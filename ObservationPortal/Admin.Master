<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="ObservationPortal.Admin" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>ABC Bank - IT Audit Observation Portal </title>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:'Poppins',sans-serif;
    background:#F3F7FB;
    overflow-x:hidden;

}

/* ================= SIDEBAR ================= */

.sidebar{

    position:fixed;
    top:0;
    left:0;
    width:260px;
    height:100vh;

    background:linear-gradient(180deg,#0054A6 0%, #00458A 55%, #003B78 100%);

    color:white;
    z-index:999;

    box-shadow:8px 0 25px rgba(0,0,0,.18);

}

/* Logo */

.logo{

    text-align:center;

    padding:35px 20px;

    background:rgba(255,255,255,.05);

    border-bottom:1px solid rgba(255,255,255,.15);

}

.logo i{

    font-size:48px;

}

.logo h2{

    margin-top:10px;

    font-size:28px;

    font-weight:700;

}

.logo p{

    margin:0;

    opacity:.9;

}

/* ================= MENU ================= */

.menu{

    margin-top:20px;

}

.menu a{

    display:flex;
    align-items:center;
    gap:15px;

    color:#fff;

    text-decoration:none;

    padding:18px 28px;

    margin:5px 12px;

    border-radius:12px;

    transition:.30s;

    font-size:16px;

    font-weight:500;

}

.menu a:hover{

    background:white;

    color:#0054A6;

    transform:translateX(6px);

    box-shadow:0 5px 18px rgba(0,0,0,.15);

}
.menu i{

    width:25px;

    text-align:center;

}

.menu a:hover i{

    color:#0054A6;

}

/* ================= CONTENT ================= */

.main{

    margin-left:260px;

    min-height:100vh;

}

/* ================= HEADER ================= */

.header{

    height:90px;

    background:#ffffff;

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:0 40px;

    border-bottom:4px solid #d71920;

    box-shadow:0 4px 15px rgba(0,0,0,.08);

}

.header-left h3{

    margin:0;

    color:#004C97;

    font-weight:700;

    font-size:34px;

}

.header-left small{

    color:#6c757d;

    font-size:15px;

}

.user-area{

    display:flex;

    align-items:center;

    gap:18px;

}

.user-area i{

    font-size:24px;

    color:#004C97;

}

/* ================= PAGE ================= */

.page{

    padding:30px;

}

/* ================= CARDS ================= */

.card{

    border:none;

    border-radius:20px;

    box-shadow:0 8px 18px rgba(0,0,0,.08);

}

/* ================= TABLE ================= */

.table{

    background:white;

}

.table thead{

    background:#004C97;

    color:white;

}

.table th{

    border:none;

}

.table td{

    vertical-align:middle;

}

.table tbody tr:hover{

    background:#F5F9FD;

}

/* ================= BUTTONS ================= */

.btn-primary{

    background:#0056B3;

    border:none;

}

.btn-primary:hover{

    background:#004A99;

}

.btn-danger{

    border:none;

}

.btn-success{

    border:none;

}

.btn-warning{

    border:none;

}

.btn-info{

    color:white;

}

    </style>

    <asp:ContentPlaceHolder
        ID="head"
        runat="server" />

</head>

<body>

<form id="form1" runat="server">

    <!-- Sidebar -->

    <div class="sidebar">

        <div class="logo">

            <i class="bi bi-bank2"></i>

            <h2>ABC Bank</h2>

            <p>IT Audit Observation Portal </p>

        </div>

        <div class="menu">

            <a href="Dashboard.aspx">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a href="Department.aspx">
                <i class="bi bi-buildings"></i>
                Department
            </a>

            <a href="ObservationType.aspx">
                <i class="bi bi-card-checklist"></i>
                Observation Type
            </a>

            <a href="Observation.aspx">
                <i class="bi bi-clipboard-data"></i>
                Observations
            </a>

            <a href="Reports.aspx">
                <i class="bi bi-file-earmark-bar-graph"></i>
                Reports
            </a>

            <a href="Login.aspx">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>

        </div>

    </div>

    <!-- Main -->

    <div class="main">

        <!-- Header -->

        <div class="header">

            <div class="header-left">

                <h3>ABC Bank</h3>

                <small>IT Audit Observation Portal </small>

            </div>

            <div class="user-area">

                <i class="bi bi-bell"></i>

                <i class="bi bi-person-circle"></i>

                <span>

                    <strong>

                        <%= char.ToUpper(Session["UserName"].ToString()[0]) + Session["UserName"].ToString().Substring(1).ToLower() %>

                    </strong>

                </span>

                <a href="Login.aspx"
                   class="btn btn-danger">

                    Logout

                </a>

            </div>

        </div>

        <!-- Page -->

        <div class="page">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </div>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</body>

</html>